---
import { Icon } from 'astro-icon/components';
import { site } from '../content/site';

interface Props {
	mode?: 'preview' | 'demo';
}

const { mode = 'preview' } = Astro.props;
const story = site.bookingStory;
const demo = site.bookingDemo;
const isDemo = mode === 'demo';
const initialScenario = story.scenarios[0];
const display = isDemo ? initialScenario : story;
const selectedPreviewSlot = story.appointment.time;
---

<figure
	class:list={[
		'booking-story relative m-0 min-w-0',
		isDemo ? 'booking-story--demo' : 'booking-story--preview',
	]}
	data-booking-story
	data-mode={mode}
	data-demo-state={isDemo ? 'idle' : undefined}
	data-scenarios={isDemo ? JSON.stringify(story.scenarios) : undefined}
	data-client-status={demo.clientStatus}
	data-typing-status={demo.typingStatus}
	data-ready-status={demo.readyStatus}
	data-booking-status={demo.bookingStatus}
	data-confirmed-status={demo.confirmedStatus}
	aria-labelledby={`booking-story-caption-${mode}`}
>
	<div class="booking-story-glow absolute inset-0 -z-1" aria-hidden="true"></div>

	{
		isDemo && (
			<div class="demo-scenarios mb-8 flex flex-wrap items-center gap-3">
				<span class="text-sm font-medium text-ink-500">{demo.scenarioLabel}</span>
				<div class="flex flex-wrap gap-2" role="group" aria-label={demo.scenarioLabel}>
					{story.scenarios.map((scenario, index) => (
						<button
							type="button"
							class="demo-scenario-button"
							data-scenario-choice={scenario.id}
							aria-pressed={index === 0 ? 'true' : 'false'}
						>
							{scenario.label}
						</button>
					))}
				</div>
			</div>
		)
	}

	<div
		class:list={[
			'booking-story-layout relative grid items-center',
			isDemo
				? 'gap-10 lg:grid-cols-[minmax(19rem,0.8fr)_minmax(28rem,1.2fr)] lg:gap-16'
				: 'min-h-132 justify-items-center',
		]}
	>
		<div class="wa-phone-shell relative mx-auto w-full max-w-[19rem] p-1.5">
			<div class="wa-phone relative flex h-[37rem] flex-col overflow-hidden">
				<div
					class="wa-statusbar flex h-7 items-center justify-between px-5 text-[0.625rem]"
				>
					<strong>{story.statusBarTime}</strong>
					<span class="flex items-center gap-1" aria-hidden="true">
						<Icon name="ph:cell-signal-high" class="size-3" />
						<Icon name="ph:wifi-high" class="size-3" />
						<Icon name="ph:battery-high" class="size-3.5" />
					</span>
				</div>

				<header class="wa-chat-header flex items-center gap-2 px-2.5 py-2 text-white">
					<Icon name="ph:caret-left" class="size-5 shrink-0" aria-hidden="true" />
					<span
						class="grid size-9 shrink-0 place-items-center rounded-full bg-white/18 text-[0.6875rem] font-bold"
						data-demo-avatar
					>
						{display.avatar}
					</span>
					<span class="min-w-0">
						<strong
							class="block truncate text-[0.8125rem] leading-tight"
							data-demo-contact
						>
							{display.contact}
						</strong>
						<small
							class="block text-[0.625rem] leading-tight text-white/78"
							data-demo-contact-status
						>
							{display.status}
						</small>
					</span>
					<span class="ml-auto flex items-center gap-3" aria-hidden="true">
						<Icon name="ph:video-camera" class="size-4" />
						<Icon name="ph:phone" class="size-4" />
						<Icon name="ph:dots-three-vertical" class="size-4" />
					</span>
				</header>

				<div
					class="wa-wallpaper flex min-h-0 flex-1 flex-col gap-2 overflow-hidden px-3 py-3"
				>
					<span
						class="wa-date mx-auto rounded-md px-2.5 py-1 text-[0.5625rem] font-medium uppercase"
					>
						{story.todayLabel}
					</span>

					<div
						class="wa-bubble wa-bubble--outgoing max-w-[88%] self-end"
						data-demo-client
					>
						<p data-demo-client-message>{display.clientMessage}</p>
						<span class="wa-message-meta">
							{story.messageTimes.client}
							<Icon name="ph:checks" class="wa-checks size-3" />
						</span>
					</div>

					{
						isDemo && (
							<div
								class="wa-bubble wa-bubble--incoming wa-typing-bubble max-w-[78%] self-start"
								data-demo-typing
							>
								<span class="wa-typing-dot" />
								<span class="wa-typing-dot" />
								<span class="wa-typing-dot" />
								<small>{story.typingLabel}</small>
							</div>
						)
					}

					<div
						class="wa-bubble wa-bubble--incoming max-w-[91%] self-start"
						data-demo-assistant
					>
						<strong class="wa-assistant-label">{story.assistantIdentity}</strong>
						<p data-demo-assistant-message>{display.assistantMessage}</p>
						<div class="mt-2 flex flex-wrap gap-2">
							{
								display.slots.map((slot) =>
									isDemo ? (
										<button
											type="button"
											class="wa-slot-button"
											data-slot-choice={slot}
											aria-pressed="false"
										>
											{slot}
										</button>
									) : (
										<span
											class:list={[
												'wa-slot-button wa-slot-button--static',
												slot === selectedPreviewSlot && 'is-selected',
											]}
										>
											{slot}
										</span>
									),
								)
							}
						</div>
						<span class="wa-message-meta">{story.messageTimes.assistant}</span>
					</div>

					<div
						class:list={[
							'wa-bubble wa-bubble--outgoing max-w-[72%] self-end',
							isDemo && 'wa-demo-message',
						]}
						data-demo-selection
					>
						<p data-selected-message>
							{
								isDemo
									? initialScenario.selectionTemplate.replace(
											'{time}',
											initialScenario.preferredSlot,
										)
									: story.selection
							}
						</p>
						<span class="wa-message-meta">
							{story.messageTimes.selection}
							<Icon name="ph:checks" class="wa-checks size-3" />
						</span>
					</div>

					<div
						class:list={[
							'wa-bubble wa-bubble--incoming max-w-[91%] self-start',
							isDemo && 'wa-demo-message',
						]}
						data-demo-confirmation
					>
						<strong class="wa-assistant-label">{story.assistantIdentity}</strong>
						<p data-confirmation-message>
							{
								isDemo
									? initialScenario.confirmationTemplate.replace(
											'{time}',
											initialScenario.preferredSlot,
										)
									: story.confirmation
							}
						</p>
						<span class="wa-message-meta">{story.messageTimes.confirmation}</span>
					</div>
				</div>

				<div class="wa-composer flex items-end gap-2 px-2 py-2.5">
					<div class="flex min-h-10 flex-1 items-center gap-2 rounded-full bg-white px-3">
						<Icon
							name="ph:smiley"
							class="size-5 shrink-0 text-whatsapp-meta"
							aria-hidden="true"
						/>
						<span class="flex-1 text-[0.6875rem] text-whatsapp-meta/75"
							>{story.composerHint}</span
						>
						<Icon
							name="ph:paperclip"
							class="size-4 shrink-0 text-whatsapp-meta"
							aria-hidden="true"
						/>
						<Icon
							name="ph:camera"
							class="size-4 shrink-0 text-whatsapp-meta"
							aria-hidden="true"
						/>
					</div>
					<span
						class="grid size-10 shrink-0 place-items-center rounded-full bg-whatsapp-accent text-white"
					>
						<Icon name="ph:microphone" class="size-4.5" aria-hidden="true" />
					</span>
				</div>
			</div>
		</div>

		{
			isDemo ? (
				<div class="booking-calendar overflow-hidden rounded-2xl bg-white">
					<header class="flex flex-wrap items-center justify-between gap-4 px-5 py-5 md:px-7">
						<div>
							<small class="block text-xs text-ink-500" data-demo-calendar-label>
								{initialScenario.calendarLabel}
							</small>
							<strong class="mt-1 block text-xl leading-tight" data-demo-calendar-day>
								{initialScenario.calendarDay}
							</strong>
						</div>
						<div class="flex items-center gap-2 rounded-full bg-brand-50 py-1.5 pr-3 pl-1.5 text-xs font-semibold text-brand-700">
							<span
								class="grid size-7 place-items-center rounded-full bg-brand-500 text-white"
								data-demo-professional-avatar
							>
								{initialScenario.professional.slice(0, 1)}
							</span>
							<span data-demo-professional>{initialScenario.professional}</span>
						</div>
					</header>

					<div class="booking-calendar-grid">
						{initialScenario.rows.map((row) => {
							const isAvailable = initialScenario.slots.includes(
								row.time as (typeof initialScenario.slots)[number],
							);
							return (
								<>
									<time class="booking-calendar-hour" data-demo-row-time>
										{row.time}
									</time>
									<div
										class:list={[
											'booking-calendar-slot',
											isAvailable && 'booking-calendar-slot--available',
										]}
										data-calendar-time={isAvailable ? row.time : undefined}
										data-demo-row
									>
										<div
											class:list={['booking-calendar-event', !row.service && 'hidden']}
											data-demo-event
										>
											<strong data-demo-event-service>{row.service}</strong>
											<small data-demo-event-client>{row.client}</small>
										</div>
										<div
											class:list={[
												'booking-calendar-available',
												!isAvailable && 'hidden',
											]}
											data-calendar-available
										>
											<span />
											{story.availableLabel}
										</div>
										<div
											class:list={['booking-calendar-pending', !isAvailable && 'hidden']}
											data-calendar-pending
										>
											<i />
											{story.transferLabel}
										</div>
										<article
											class:list={[
												'booking-calendar-appointment',
												!isAvailable && 'hidden',
											]}
											data-calendar-appointment
										>
											<div>
												<strong data-demo-appointment-service>
													{initialScenario.appointment.service}
												</strong>
												<span>
													<Icon name="ph:check" class="size-3" />
													<span data-demo-appointment-status>
														{initialScenario.appointment.status}
													</span>
												</span>
											</div>
											<small data-demo-appointment-client>
												{initialScenario.appointment.client}
											</small>
										</article>
									</div>
								</>
							);
						})}
					</div>
				</div>
			) : (
				<div class="booking-preview-receipt absolute right-[2%] bottom-[13%] hidden w-52 rounded-2xl bg-white p-4 sm:block">
					<span class="grid size-9 place-items-center rounded-xl bg-brand-100 text-brand-700">
						<Icon name="ph:calendar-check" class="size-5" />
					</span>
					<strong class="mt-3 block text-sm">{demo.previewReceiptLabel}</strong>
					<small class="mt-1 block text-xs text-ink-500">
						{demo.previewReceiptDetail}
					</small>
				</div>
			)
		}
	</div>

	{
		isDemo && (
			<div class="mt-7 flex flex-wrap items-center justify-between gap-4">
				<div>
					<div
						class="flex items-center gap-2 text-sm font-medium text-ink-700"
						aria-live="polite"
					>
						<span class="demo-status-dot size-2.5 rounded-full bg-brand-500" />
						<span data-demo-status>{demo.clientStatus}</span>
					</div>
					<p class="mt-1.5 max-w-xl text-xs text-ink-500" data-demo-note>
						{initialScenario.note}
					</p>
				</div>
				<button
					type="button"
					class="demo-reset hidden min-h-11 items-center gap-2 rounded-full bg-white px-4 text-sm font-semibold text-ink-700 shadow-surface transition-[color,transform] duration-200 hover:text-brand-700 active:scale-[0.98]"
					data-demo-reset
				>
					<Icon name="ph:arrow-counter-clockwise" class="size-4" />
					{demo.resetLabel}
				</button>
			</div>
		)
	}

	<figcaption id={`booking-story-caption-${mode}`} class="sr-only">
		{isDemo ? story.label : story.previewLabel}
	</figcaption>
</figure>

<script>
	type DemoScenario = {
		id: string;
		label: string;
		contact: string;
		avatar: string;
		status: string;
		clientMessage: string;
		assistantMessage: string;
		slots: [string, string];
		preferredSlot: string;
		selectionTemplate: string;
		confirmationTemplate: string;
		calendarLabel: string;
		calendarDay: string;
		professional: string;
		note: string;
		rows: Array<{ time: string; service: string; client: string }>;
		appointment: { client: string; service: string; status: string };
	};

	const demos = document.querySelectorAll<HTMLElement>(
		'[data-booking-story][data-mode="demo"]',
	);

	demos.forEach((demo) => {
		const scenarios = JSON.parse(demo.dataset.scenarios ?? '[]') as DemoScenario[];
		const scenarioButtons = demo.querySelectorAll<HTMLButtonElement>(
			'[data-scenario-choice]',
		);
		const slotButtons = demo.querySelectorAll<HTMLButtonElement>('[data-slot-choice]');
		const calendarRows = demo.querySelectorAll<HTMLElement>('[data-demo-row]');
		const calendarTimes = demo.querySelectorAll<HTMLElement>('[data-demo-row-time]');
		const clientMessage = demo.querySelector<HTMLElement>('[data-demo-client-message]');
		const assistantMessage = demo.querySelector<HTMLElement>(
			'[data-demo-assistant-message]',
		);
		const selectedMessage = demo.querySelector<HTMLElement>('[data-selected-message]');
		const confirmationMessage = demo.querySelector<HTMLElement>(
			'[data-confirmation-message]',
		);
		const status = demo.querySelector<HTMLElement>('[data-demo-status]');
		const note = demo.querySelector<HTMLElement>('[data-demo-note]');
		const reset = demo.querySelector<HTMLButtonElement>('[data-demo-reset]');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const timers = new Set<number>();
		let currentScenarioIndex = 0;
		let allowScenarioAdvance = true;
		let hasStarted = false;

		const query = (selector: string) => demo.querySelector<HTMLElement>(selector);

		const clearTimers = () => {
			timers.forEach((timer) => window.clearTimeout(timer));
			timers.clear();
		};

		const schedule = (callback: () => void, delay: number) => {
			const timer = window.setTimeout(() => {
				timers.delete(timer);
				callback();
			}, delay);
			timers.add(timer);
		};

		const setStatus = (value: string | undefined) => {
			if (status && value) status.textContent = value;
		};

		const setState = (
			state: 'idle' | 'client' | 'typing' | 'ready' | 'booking' | 'confirmed',
		) => {
			demo.dataset.demoState = state;
			const statusByState = {
				idle: demo.dataset.clientStatus,
				client: demo.dataset.clientStatus,
				typing: demo.dataset.typingStatus,
				ready: demo.dataset.readyStatus,
				booking: demo.dataset.bookingStatus,
				confirmed: demo.dataset.confirmedStatus,
			};
			setStatus(statusByState[state]);
		};

		const setText = (selector: string, value: string) => {
			const element = query(selector);
			if (element) element.textContent = value;
		};

		const renderScenario = (scenario: DemoScenario) => {
			setText('[data-demo-avatar]', scenario.avatar);
			setText('[data-demo-contact]', scenario.contact);
			setText('[data-demo-contact-status]', scenario.status);
			setText('[data-demo-calendar-label]', scenario.calendarLabel);
			setText('[data-demo-calendar-day]', scenario.calendarDay);
			setText('[data-demo-professional-avatar]', scenario.professional.slice(0, 1));
			setText('[data-demo-professional]', scenario.professional);
			if (clientMessage) clientMessage.textContent = scenario.clientMessage;
			if (assistantMessage) assistantMessage.textContent = scenario.assistantMessage;
			if (note) note.textContent = scenario.note;

			scenarioButtons.forEach((button) => {
				button.setAttribute(
					'aria-pressed',
					String(button.dataset.scenarioChoice === scenario.id),
				);
			});

			slotButtons.forEach((button, index) => {
				const slot = scenario.slots[index];
				button.textContent = slot;
				button.dataset.slotChoice = slot;
				button.disabled = true;
				button.setAttribute('aria-pressed', 'false');
			});

			calendarRows.forEach((row, index) => {
				const rowData = scenario.rows[index];
				const time = calendarTimes[index];
				const event = row.querySelector<HTMLElement>('[data-demo-event]');
				const available = row.querySelector<HTMLElement>('[data-calendar-available]');
				const pending = row.querySelector<HTMLElement>('[data-calendar-pending]');
				const appointment = row.querySelector<HTMLElement>('[data-calendar-appointment]');
				const isAvailable = scenario.slots.includes(rowData.time);

				if (time) time.textContent = rowData.time;
				row.dataset.calendarTime = isAvailable ? rowData.time : '';
				row.removeAttribute('data-selected');
				event?.classList.toggle('hidden', !rowData.service);
				available?.classList.toggle('hidden', !isAvailable);
				pending?.classList.toggle('hidden', !isAvailable);
				appointment?.classList.toggle('hidden', !isAvailable);
				const eventService = row.querySelector<HTMLElement>('[data-demo-event-service]');
				const eventClient = row.querySelector<HTMLElement>('[data-demo-event-client]');
				if (eventService) eventService.textContent = rowData.service;
				if (eventClient) eventClient.textContent = rowData.client;
			});

			demo
				.querySelectorAll<HTMLElement>('[data-demo-appointment-service]')
				.forEach((element) => {
					element.textContent = scenario.appointment.service;
				});
			demo
				.querySelectorAll<HTMLElement>('[data-demo-appointment-client]')
				.forEach((element) => {
					element.textContent = scenario.appointment.client;
				});
			demo
				.querySelectorAll<HTMLElement>('[data-demo-appointment-status]')
				.forEach((element) => {
					element.textContent = scenario.appointment.status;
				});
		};

		const showReset = (visible: boolean) => {
			reset?.classList.toggle('hidden', !visible);
			reset?.classList.toggle('flex', visible);
		};

		const confirmSelection = () => {
			setState('confirmed');
			showReset(true);

			if (allowScenarioAdvance && currentScenarioIndex < scenarios.length - 1) {
				schedule(() => {
					currentScenarioIndex += 1;
					playScenario(currentScenarioIndex, true);
				}, 2800);
			}
		};

		const selectTime = (selectedTime: string, automatic: boolean) => {
			clearTimers();
			const scenario = scenarios[currentScenarioIndex];
			if (!scenario) return;

			if (!automatic) allowScenarioAdvance = false;
			demo.dataset.selectedTime = selectedTime;
			if (selectedMessage) {
				selectedMessage.textContent = scenario.selectionTemplate.replace(
					'{time}',
					selectedTime,
				);
			}
			if (confirmationMessage) {
				confirmationMessage.textContent = scenario.confirmationTemplate.replace(
					'{time}',
					selectedTime,
				);
			}

			slotButtons.forEach((button) => {
				const selected = button.dataset.slotChoice === selectedTime;
				button.disabled = true;
				button.setAttribute('aria-pressed', String(selected));
			});
			calendarRows.forEach((row) => {
				if (row.dataset.calendarTime === selectedTime) {
					row.setAttribute('data-selected', 'true');
				} else {
					row.removeAttribute('data-selected');
				}
			});

			setState('booking');
			schedule(confirmSelection, reduceMotion.matches ? 0 : 1050);
		};

		const playScenario = (index: number, canAdvance: boolean) => {
			clearTimers();
			const scenario = scenarios[index];
			if (!scenario) return;

			currentScenarioIndex = index;
			allowScenarioAdvance = canAdvance;
			delete demo.dataset.selectedTime;
			renderScenario(scenario);
			showReset(false);
			setState('idle');

			if (reduceMotion.matches) {
				setState('ready');
				selectTime(scenario.preferredSlot, true);
				return;
			}

			schedule(() => setState('client'), 250);
			schedule(() => setState('typing'), 1300);
			schedule(() => {
				setState('ready');
				slotButtons.forEach((button) => {
					button.disabled = false;
				});
			}, 2400);
			schedule(() => selectTime(scenario.preferredSlot, true), 4300);
		};

		slotButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const selectedTime = button.dataset.slotChoice;
				if (!selectedTime || demo.dataset.demoState !== 'ready') return;
				selectTime(selectedTime, false);
			});
		});

		scenarioButtons.forEach((button, index) => {
			button.addEventListener('click', () => {
				playScenario(index, false);
			});
		});

		reset?.addEventListener('click', () => playScenario(currentScenarioIndex, false));

		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries[0]?.isIntersecting || hasStarted) return;
				hasStarted = true;
				playScenario(0, true);
				observer.disconnect();
			},
			{ threshold: 0.3 },
		);

		observer.observe(demo);
	});
</script>
