---
import { Icon } from 'astro-icon/components';
import BrandLogo from './BrandLogo.astro';
import { site } from '../content/site';

const fieldClass =
	'h-12 w-full rounded-xl border border-line bg-canvas px-3.5 text-sm text-ink-950 transition-[background-color,border-color,box-shadow] hover:border-brand-500/60 focus-visible:border-brand-500 focus-visible:bg-white focus-visible:shadow-focus';
const labelClass = 'grid gap-2 text-sm font-medium text-ink-950';
---

<dialog
	id="lead-dialog"
	aria-labelledby="lead-dialog-title"
	class="m-auto max-h-[calc(100dvh-2rem)] w-[min(34rem,calc(100vw-2rem))] overscroll-contain rounded-2xl bg-white p-0 text-ink-950 shadow-modal backdrop:bg-ink-950/45 backdrop:backdrop-blur-sm"
>
	<div class="p-6 sm:p-8">
		<div class="flex items-start justify-between gap-5">
			<div>
				<BrandLogo class="origin-left scale-90" />
				<p
					class="m-0 mt-5 text-xs font-semibold tracking-[0.08em] text-brand-700 uppercase"
				>
					{site.form.kicker}
				</p>
				<h2 id="lead-dialog-title" class="mt-2 text-2xl font-semibold tracking-tight">
					{site.form.title}
				</h2>
			</div>
			<button
				type="button"
				data-close-dialog
				aria-label={site.form.cancel}
				class="grid size-11 shrink-0 place-items-center rounded-xl text-ink-500 transition-colors hover:bg-brand-50 hover:text-brand-700"
			>
				<Icon name="ph:x" class="size-5" aria-hidden="true" />
			</button>
		</div>

		<p class="mt-3 max-w-[54ch] text-sm leading-relaxed text-ink-700">
			{site.form.description}
		</p>

		<form id="lead-form" class="mt-7 grid gap-4">
			<label class={labelClass}>
				<span>{site.form.fields.name}</span>
				<input
					name="name"
					autocomplete="name"
					required
					maxlength="80"
					class={fieldClass}
				/>
			</label>
			<label class={labelClass}>
				<span>{site.form.fields.business}</span>
				<input
					name="business"
					autocomplete="organization"
					required
					maxlength="100"
					class={fieldClass}
				/>
			</label>
			<div class="grid gap-4 sm:grid-cols-2">
				<label class={labelClass}>
					<span>{site.form.fields.city}</span>
					<input
						name="city"
						autocomplete="address-level2"
						required
						maxlength="80"
						class={fieldClass}
					/>
				</label>
				<label class={labelClass}>
					<span>{site.form.fields.teamSize}</span>
					<select name="teamSize" required class={fieldClass}>
						<option value="" disabled selected></option>
						{
							site.form.teamOptions.map((option) => (
								<option value={option}>{option}</option>
							))
						}
					</select>
				</label>
			</div>

			<div
				class="mt-3 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end"
			>
				<button
					type="button"
					data-close-dialog
					class="min-h-11 rounded-full px-5 text-sm font-semibold text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-700"
				>
					{site.form.cancel}
				</button>
				<button
					type="submit"
					class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-brand-700 px-6 text-sm font-semibold text-white shadow-brand transition-[background-color,transform] hover:bg-brand-800 active:scale-[0.98]"
				>
					{site.form.submit}
					<Icon name="ph:arrow-right" class="size-4" aria-hidden="true" />
				</button>
			</div>
		</form>
	</div>
</dialog>
